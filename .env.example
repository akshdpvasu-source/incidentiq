# Copy this file to .env and fill in what you need. Never commit .env.

# --- LLM provider: anthropic | openai | gemini | ollama ---------------------
# If the key for the chosen provider is empty or the call fails,
# IncidentIQ falls back to local Ollama (free). With no LLM at all the app still
# works: summaries and chat replies fall back to the most similar past resolutions.
#
# Set up for Gemini (free tier): get a key at https://aistudio.google.com ("Get API key"),
# paste it after GEMINI_API_KEY= below, copy this file to .env, restart Streamlit.
# The sidebar should then show "gemini (key set)". Never share or commit the key.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Mock ticket API --------------------------------------------------------
# Change the port here AND in the uvicorn command if 8000 is already taken.
API_URL=http://127.0.0.1:8000

# --- Synthetic data ---------------------------------------------------------
N_TICKETS=20000
SEED=42

# --- AWS (optional) ---------------------------------------------------------
# Leave S3_BUCKET empty to run fully local. Credentials: AWS_PROFILE from
# `aws configure`, or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
S3_BUCKET=
AWS_REGION=us-east-1
AWS_PROFILE=
